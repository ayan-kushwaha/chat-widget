PORT=5000
APP_NAME="Clage AI Engine"
AI_ENGINE_URL=http://127.0.0.1:5000
MONGO_URI=mongodb://localhost:27017/cluaiz
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8000
OLLAMA_URL=http://localhost:11434

# ?? AI Providers
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_GROQ=true
ENABLE_GEMINI=true
ENABLE_OLLAMA=false
USE_MODEL=gemini 
GEMINI_MODEL=gemini-2.0-flash-lite-001
GEMINI_API_KEY=AIzaSy_your_key_here
OLLAMA_EMBED_MODEL=bge-m3:latest

# ?? Storage (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=chat-assets
MINIO_SECURE=False

# ?? Social & Tracking
WHATSAPP_TOKEN=your_graph_api_token
WHATSAPP_PHONE_ID=your_phone_number_id
OWNER_WHATSAPP_NUMBER=+91XXXXXXXXXX
WHATSAPP_VERIFY_TOKEN=cluaiz_webhook_verify

# ?? Pillar V (ClickHouse)
CLICKHOUSE_USER=cluaiz_engine
CLICKHOUSE_PASSWORD=your_password_here
CLICKHOUSE_DB=cluaiz
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
