PORT=4000
MODE=local
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_char_encryption_key_here
WORKER_SOCKET_TOKEN=your_worker_token_here
FRONTEND_URL=http://localhost:3000

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@yourdomain.com

# AI Strategy
ENABLE_GEMINI=false
ENABLE_GROQ=true
ENABLE_OLLAMA=true
USE_MODEL=auto

# Providers
GROQ_API_KEY=gsk_your_key_here
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b-qwen-distill-q4_K_M
OLLAMA_URL=http://localhost:11434

# Databases
MONGO_URI=mongodb://127.0.0.1:27017/cluaiz
REDIS_URL=redis://localhost:6379
AI_ENGINE_URL=http://127.0.0.1:5000

# Email (Zoho/SMTP)
MAIL_NOREPLY_USER=noreply@yourdomain.com
MAIL_NOREPLY_PASS=your_email_password
MAIL_SALES_USER=sales@yourdomain.com
MAIL_SALES_PASS=your_email_password

# Payment (Razorpay)
RAZORPAY_KEY_ID=mock
RAZORPAY_KEY_SECRET=mock
