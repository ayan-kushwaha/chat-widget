FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

WORKDIR /app

# Final Timeout Protection
ENV PIP_DEFAULT_TIMEOUT=2000

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    git \
    curl \
    libssl-dev \
    pkg-config \
    cmake \
    g++ \
    libsentencepiece-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust Toolchain (Needed for Mistral-RS source build)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN python3 -m pip install --no-cache-dir --upgrade pip
RUN python3 -m pip install --no-cache-dir transformers autoawq accelerate fastapi uvicorn loguru safetensors httpx huggingface_hub tokenizers protobuf sentencepiece tiktoken pynvml

# Compile Mistral-RS from source with CUDA + AWQ Support (Take ~15-20 mins)
ENV MISTRALRS_FEATURES=cuda,awq
RUN python3 -m pip install "mistralrs[cuda]" --no-cache-dir

COPY src/ ./src/

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
